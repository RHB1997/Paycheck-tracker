rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validPaycheck(data) {
      return data.keys().hasAll([
          'label',
          'payDate',
          'currencyCode',
          'grossMinor',
          'taxWithheldMinor',
          'netMinor',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'label',
          'payDate',
          'currencyCode',
          'grossMinor',
          'taxWithheldMinor',
          'netMinor',
          'createdAt',
          'updatedAt'
        ])
        && data.label is string
        && data.label.size() <= 80
        && data.payDate is timestamp
        && data.currencyCode is string
        && data.currencyCode.matches('^[A-Z]{3}$')
        && data.grossMinor is int
        && data.grossMinor >= 0
        && data.taxWithheldMinor is int
        && data.taxWithheldMinor >= 0
        && data.taxWithheldMinor <= data.grossMinor
        && data.netMinor == data.grossMinor - data.taxWithheldMinor
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validEntry(data) {
      return data.keys().hasAll([
          'paycheckId',
          'kind',
          'category',
          'note',
          'amountMinor',
          'currencyCode',
          'occurredAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'paycheckId',
          'kind',
          'category',
          'note',
          'amountMinor',
          'currencyCode',
          'occurredAt',
          'createdAt',
          'updatedAt'
        ])
        && data.paycheckId is string
        && data.kind in ['expense', 'saving']
        && data.category is string
        && data.category.size() <= 50
        && data.note is string
        && data.note.size() <= 240
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.currencyCode is string
        && data.currencyCode.matches('^[A-Z]{3}$')
        && data.occurredAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/paychecks/{paycheckId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId) && validPaycheck(request.resource.data);
      allow update: if signedInAs(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && validPaycheck(request.resource.data);
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/entries/{entryId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId) && validEntry(request.resource.data);
      allow update: if signedInAs(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && validEntry(request.resource.data);
      allow delete: if signedInAs(userId);
    }

    // Private user settings, including locale and tax jurisdiction preferences.
    match /users/{userId}/settings/{settingId} {
      allow read, write: if signedInAs(userId);
    }

    // All other documents are private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
